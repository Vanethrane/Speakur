{
  "name": "speakur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --turbopack",
    "ia:hubs": "node scripts/build-ia-hubs.mjs",
    "sitemap": "node scripts/build-sitemap.mjs",
    "build:static": "node scripts/generate-word-pages.mjs --fast && node scripts/build-global-search-index.mjs && node scripts/build-pwa.mjs && node scripts/patch-cwv.mjs && node scripts/patch-pwa.mjs && node scripts/build-sitemap.mjs",
    "build": "node scripts/build-sitemap.mjs && node scripts/build-global-search-index.mjs && node scripts/build-pwa.mjs && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "assert:inbound": "node scripts/assert-inbound-links.mjs",
    "catalog:build": "node scripts/fetch-google-seeds.mjs && node scripts/build-large-catalog.mjs --target=70000",
    "catalog:expand": "node scripts/fetch-google-seeds.mjs && node scripts/build-large-catalog.mjs --target=70000 && node scripts/generate-word-pages.mjs --fast --incremental && node scripts/finish-word-index.mjs && node scripts/build-global-search-index.mjs && node scripts/build-sitemap.mjs",
    "generate:words": "node scripts/generate-word-pages.mjs",
    "generate:words:fast": "node scripts/generate-word-pages.mjs --fast",
    "add-word": "node scripts/add-word.mjs",
    "serve": "node scripts/serve.mjs",
    "export:guides": "node scripts/export-guides.mjs",
    "refill:words": "node scripts/refill-word-pages.mjs",
    "fill:meta": "node scripts/fill-missing-word-meta.mjs --resume",
    "fill:meta:fresh": "node scripts/fill-missing-word-meta.mjs",
    "add:verified": "node scripts/add-verified-words.mjs",
    "patch:crosslinks": "node scripts/patch-cross-links.mjs",
    "patch:cwv": "node scripts/patch-cwv.mjs",
    "search:index": "node scripts/build-search-index.mjs && node scripts/build-global-search-index.mjs",
    "global-search:index": "node scripts/build-global-search-index.mjs",
    "word-lookup": "node scripts/build-word-lookup.mjs",
    "pwa:build": "node scripts/build-pwa.mjs",
    "pwa:patch": "node scripts/patch-pwa.mjs",
    "favicon": "node scripts/build-favicon.mjs",
    "assert:seo-titles": "node scripts/assert-seo-titles.mjs",
    "ads:txt": "node scripts/fetch-ads-txt.mjs",
    "patch:ezoic": "node scripts/patch-ezoic-head.mjs",
    "patch:howto": "node scripts/patch-howto-seo.mjs",
    "patch:word-reference": "node scripts/patch-word-reference.mjs",
    "write:trust": "node scripts/write-trust-pages.mjs",
    "regen:showcase": "node scripts/regen-showcase-words.mjs",
    "strip:adsterra": "node scripts/strip-adsterra.mjs",
    "assert:faq": "node scripts/assert-faq-schema.mjs"
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.879.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
