# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Free by default: Google TTS (no key) + dictionary audio + browser speech.
# Optional paid upgrade:
# TTS_PROVIDER=openai
# OPENAI_API_KEY=

# Optional Cloudflare R2 (omit to use local .cache/audio)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=speakur-audio
R2_PUBLIC_URL=https://pub-r2.speakur.com
